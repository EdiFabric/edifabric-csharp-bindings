<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes the EdiFabric.Native.X12 package from dist/ like a user's project would.
       Build it from a copy outside the repository: dotnet run -p:EdiFabricVersion=<version> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EdiFabric.Native.X12" Version="$(EdiFabricVersion)" />
  </ItemGroup>

</Project>
